# AWS + GenAI Production Architecture Environment Variables

# AWS Configuration
AWS_REGION=us-east-1
ENVIRONMENT=production

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.2

# Amazon OpenSearch Serverless (AOSS)
OPENSEARCH_ENDPOINT=https://xxxxxx.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX_NAME=genai-knowledge-base
OPENSEARCH_VECTOR_FIELD=embedding
OPENSEARCH_DIMENSION=1024

# S3 Document Ingestion
DOCUMENT_BUCKET_NAME=genai-knowledge-docs-prod
PROCESSED_BUCKET_NAME=genai-knowledge-processed-prod

# Database (PostgreSQL / Aurora Serverless)
DATABASE_URL=postgresql://genai_user:supersecretpassword@aurora-cluster.cluster-custom.us-east-1.rds.amazonaws.com:5432/genaidb

# Security & CORS
ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:3000
API_KEY_SECRET_NAME=genai/api-keys/prod
JWT_SECRET_NAME=genai/jwt-secret/prod

# Observability
ENABLE_XRAY=true
LOG_LEVEL=INFO
